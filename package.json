{
  "name": "veneer",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "packages/react/spike",
    "examples/*"
  ],
  "scripts": {
    "build": "npm run build -w @veneer/react",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e -w @veneer/react",
    "typecheck": "tsc -p tsconfig.types.json",
    "build:demo": "npm run build -w @veneer/react && npm run build -w veneer-demo"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "typescript": "^5.9.0"
  }
}
