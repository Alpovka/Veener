# Copy this file to .env.local and fill in your keys.

# --- AI UI generation (the live demo) ---
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Veneer licensing (pick one; leave both empty for local development) ---
# Hosted generation through Veneer Cloud (your Gemini key is passed through, never stored):
VENEER_CLOUD_API_KEY=
# VENEER_CLOUD_API_BASE=https://api.veneer.dev
# Or self-hosted @veneer/server with a license check per generation:
VENEER_LICENSE_KEY=
# VENEER_LICENSE_API_BASE=https://api.veneer.dev

# --- Waitlist (Resend) ---
# Required: your Resend API key — https://resend.com/api-keys
RESEND_API_KEY=
# Optional: an address that receives a "new signup" email for each join.
WAITLIST_NOTIFY=
# Optional: a Resend Audience id to add contacts to — https://resend.com/audiences
RESEND_AUDIENCE_ID=
# Optional: a verified from-address (defaults to Resend's test sender).
# e.g. "Veneer <hello@yourdomain.com>"
WAITLIST_FROM=
