{
  "name": "veneer-sdk",
  "version": "0.2.0",
  "description": "An MCP for in-app personalization — an open-source React npm package that lets your end users redesign your app's UI with AI, inside a hard security sandbox.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.js",
  "module": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./server": "./src/server/index.js"
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node e2e/run.mjs",
    "sync-demo": "node scripts/sync-demo.mjs"
  },
  "keywords": [
    "react",
    "ai",
    "personalization",
    "sandbox",
    "iframe",
    "mcp",
    "ui-generation"
  ],
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@babel/parser": "^7.29.0",
    "@babel/traverse": "^7.29.0"
  },
  "devDependencies": {
    "@babel/standalone": "7.29.8",
    "@fontsource/inter": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "esbuild": "^0.28.2",
    "jsdom": "^27.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "vitest": "^5.0.0"
  }
}
